<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ═══════════════════ MAIN CONTENT ═══════════════════ -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/screenBackground">

        <!-- ── Toolbar ── -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorPrimary"
            android:elevation="0dp"
            app:title="FreshCart"
            app:titleTextColor="@color/white"
            app:titleTextAppearance="@style/ToolbarTitle">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTrackOrder"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Track Order 🛵"
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:backgroundTint="#FF9800"
                    android:layout_marginEnd="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:visibility="gone"
                    app:cornerRadius="16dp" />

                <FrameLayout
                    android:id="@+id/flNotification"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp">

                    <ImageView
                        android:id="@+id/ivNotification"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_notifications"
                        android:contentDescription="Notifications"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tvNotificationBadge"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-4dp"
                        android:layout_marginEnd="-4dp"
                        android:background="@drawable/bg_badge"
                        android:textColor="@color/white"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:visibility="gone"
                        tools:text="1"
                        tools:visibility="visible" />
                </FrameLayout>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_profile_placeholder"
                    android:scaleType="centerInside"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    android:padding="6dp"
                    android:background="@drawable/bg_profile_circle"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/white"
                    android:contentDescription="Profile" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/ivCart"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_cart"
                        android:contentDescription="Cart" />

                    <TextView
                        android:id="@+id/tvCartBadge"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-4dp"
                        android:layout_marginEnd="-4dp"
                        android:background="@drawable/bg_badge"
                        android:textColor="@color/white"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:visibility="gone" />
                </FrameLayout>

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

        <!-- ── Search Bar ── -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/SearchField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="0dp"
            android:hint="Search groceries…"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/colorPrimary"
            app:boxBackgroundColor="@color/cardBackground">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/textPrimary"
                android:maxLines="1"
                android:background="@null" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── Category Chips (horizontal scroll, Swiggy-style) ── -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategoryChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:nestedScrollingEnabled="false" />

        <!-- ── Dietary Tags Strip (Feature 7) ── -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDietaryTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:nestedScrollingEnabled="false" />

        <!-- ── Scrollable Body ── -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/mainScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Loading Shimmer Layout -->
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmer_view_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:shimmer_auto_start="true">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <include layout="@layout/shimmer_item_product" />
                        <include layout="@layout/shimmer_item_product" />
                        <include layout="@layout/shimmer_item_product" />
                        <include layout="@layout/shimmer_item_product" />
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>

                <!-- Actual Content Layout (hidden while loading) -->
                <LinearLayout
                    android:id="@+id/llHomeContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="24dp"
                    android:visibility="gone">

                    <!-- ── Quick Add Section (New) ── -->
                    <LinearLayout
                        android:id="@+id/llQuickAddSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#FFF9E7"
                        android:paddingBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="14dp"
                            android:paddingBottom="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚡ Quick Add"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#A67C00" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Essentials you might need"
                                android:textSize="11sp"
                                android:textColor="#B09B50"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvQuickAdd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            android:clipToPadding="false"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@color/screenBackground" />

                    <!-- ── Banner Carousel ── -->
                    <LinearLayout
                        android:id="@+id/llBannerSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/cardBackground"
                        android:paddingTop="8dp"
                        android:paddingBottom="12dp">

                        <androidx.viewpager2.widget.ViewPager2
                            android:id="@+id/vpBanners"
                            android:layout_width="match_parent"
                            android:layout_height="176dp"
                            android:clipToPadding="false"
                            android:clipChildren="false" />

                        <!-- Dot Indicators -->
                        <LinearLayout
                            android:id="@+id/llDotIndicators"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:id="@+id/divBanners"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@color/screenBackground" />

                    <!-- ── Shop by Category Grid ── -->
                    <LinearLayout
                        android:id="@+id/llCategoryGridSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/cardBackground"
                        android:paddingBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="14dp"
                            android:paddingBottom="8dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🛍️ Shop by Category"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/textPrimary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Explore what we have for you"
                                    android:textSize="11sp"
                                    android:textColor="@color/textSecondary"
                                    android:layout_marginTop="1dp" />
                            </LinearLayout>

                            <!-- Opens the sidebar drawer -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnOpenCategories"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="View All"
                                android:textSize="12sp"
                                android:textColor="@color/colorPrimary"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:strokeColor="@color/colorPrimary"
                                app:cornerRadius="18dp" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvCategoryGrid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:nestedScrollingEnabled="false" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:id="@+id/divCategoryGrid"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@color/screenBackground" />

                    <!-- ── Today's Offers Strip ── -->
                    <LinearLayout
                        android:id="@+id/llOffersSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/cardBackground"
                        android:paddingBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="14dp"
                            android:paddingBottom="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💰 Today's Offers"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/textPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Grab them before they're gone!"
                                android:textSize="11sp"
                                android:textColor="@color/textSecondary"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvOffers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            android:clipToPadding="false"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:nestedScrollingEnabled="false" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:id="@+id/divOffers"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@color/screenBackground" />

                    <!-- ── Why FreshCart? Trust Badges ── -->
                    <LinearLayout
                        android:id="@+id/llTrustSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/cardBackground"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✅ Why FreshCart?"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/textPrimary"
                            android:layout_marginBottom="12dp" />

                        <!-- Trust badge row 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <!-- Badge 1: Free Delivery -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/bg_trust_badge"
                                android:padding="14dp"
                                android:layout_marginEnd="4dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🚚"
                                    android:textSize="28sp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Free Delivery"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/textPrimary"
                                    android:layout_marginTop="6dp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="On orders ₹199+"
                                    android:textSize="10sp"
                                    android:textColor="@color/textSecondary"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <!-- Badge 2: Fresh Guarantee -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/bg_trust_badge"
                                android:padding="14dp"
                                android:layout_marginStart="4dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🥬"
                                    android:textSize="28sp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="100% Fresh"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/textPrimary"
                                    android:layout_marginTop="6dp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Quality guaranteed"
                                    android:textSize="10sp"
                                    android:textColor="@color/textSecondary"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                        </LinearLayout>

                        <!-- Trust badge row 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Badge 3: Best Prices -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/bg_trust_badge"
                                android:padding="14dp"
                                android:layout_marginEnd="4dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="💸"
                                    android:textSize="28sp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Best Prices"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/textPrimary"
                                    android:layout_marginTop="6dp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Save up to 60%"
                                    android:textSize="10sp"
                                    android:textColor="@color/textSecondary"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <!-- Badge 4: Easy Returns -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/bg_trust_badge"
                                android:padding="14dp"
                                android:layout_marginStart="4dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🔄"
                                    android:textSize="28sp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Easy Returns"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/textPrimary"
                                    android:layout_marginTop="6dp" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="No questions asked"
                                    android:textSize="10sp"
                                    android:textColor="@color/textSecondary"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:id="@+id/divTrust"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@color/screenBackground" />

                    <!-- ── Feature 5: Buy It Again Section ── -->
                    <LinearLayout
                        android:id="@+id/llBuyItAgainSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/cardBackground"
                        android:paddingBottom="12dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="14dp"
                            android:paddingBottom="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔄 Buy It Again"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/textPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Based on your order history"
                                android:textSize="11sp"
                                android:textColor="@color/textSecondary"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvBuyItAgain"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            android:clipToPadding="false"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:nestedScrollingEnabled="false" />

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:background="@color/screenBackground"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>

                    <!-- ── Most Shopped Section ── -->
                    <LinearLayout
                        android:id="@+id/llMostShoppedBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Section title row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="6dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🔥 Most Shopped"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/textPrimary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Popular picks near you"
                                    android:textSize="11sp"
                                    android:textColor="@color/textSecondary"
                                    android:layout_marginTop="1dp" />
                            </LinearLayout>

                        </LinearLayout>

                        <!-- Horizontal swipeable product strip -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvMostShopped"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            android:clipToPadding="false"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:nestedScrollingEnabled="false" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:id="@+id/divMostShopped"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@color/screenBackground"
                        android:layout_marginTop="8dp" />

                    <!-- ── Newly Added Section ── -->
                    <LinearLayout
                        android:id="@+id/llNewlyAddedSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/cardBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="6dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvNewlyAddedTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="✨ Newly Added"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/textPrimary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Fresh arrivals just for you"
                                    android:textSize="11sp"
                                    android:textColor="@color/textSecondary"
                                    android:layout_marginTop="1dp" />
                            </LinearLayout>

                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvNewlyAdded"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            android:clipToPadding="false"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="12dp"
                            android:nestedScrollingEnabled="false" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:id="@+id/divNewlyAdded"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@color/screenBackground" />

                    <!-- ── Best Deals Section ── -->
                    <LinearLayout
                        android:id="@+id/llBestDealsSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/cardBackground">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="6dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvHighestDiscountTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🏷️ Best Deals Today"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/textPrimary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Today's biggest savings"
                                    android:textSize="11sp"
                                    android:textColor="@color/textSecondary"
                                    android:layout_marginTop="1dp" />
                            </LinearLayout>

                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvHighestDiscount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            android:clipToPadding="false"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="12dp"
                            android:nestedScrollingEnabled="false" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:id="@+id/divBestDeals"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@color/screenBackground" />

                    <!-- ════════════════════════════════════════════════════
                         FILTERED PRODUCTS — 2-column grid
                         Only visible when a specific category is selected
                         ════════════════════════════════════════════════════ -->

                    <!-- Section header (shown only when filtering) -->
                    <LinearLayout
                        android:id="@+id/llFilteredHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="8dp"
                        android:background="@color/cardBackground"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvSelectedCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="All Products"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/textPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Filtered products"
                            android:textSize="11sp"
                            android:textColor="@color/textSecondary"
                            android:layout_marginTop="1dp" />

                    </LinearLayout>

                    <!-- 2-column product grid (only when filtering) -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvProducts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/screenBackground"
                        android:clipToPadding="false"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="16dp"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone" />

                </LinearLayout>
            </FrameLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <include
        android:id="@+id/layoutCartStrip"
        layout="@layout/layout_cart_strip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp" />

    </RelativeLayout>

    <!-- ═══════════════════ DRAWER SIDEBAR ═══════════════════ -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/cardBackground"
        android:orientation="vertical"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛍️ Categories"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Browse by category"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSidebarCategories"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
