<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider"
    app:cardBackgroundColor="@color/cardBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Product Image -->
        <FrameLayout
            android:id="@+id/imgFrame"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="#F8F9FA"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/imgCartProduct"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:contentDescription="Cart Product Image"
                android:scaleType="fitCenter"
                android:padding="4dp" />
        </FrameLayout>

        <!-- Product Name -->
        <TextView
            android:id="@+id/tvCartProductName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Product Name"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/imgFrame"
            app:layout_constraintEnd_toStartOf="@id/btnRemove"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Unit Price -->
        <TextView
            android:id="@+id/tvCartUnitPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="₹0 each"
            android:textSize="12sp"
            android:textColor="@color/textSecondary"
            android:layout_marginStart="12dp"
            android:layout_marginTop="3dp"
            app:layout_constraintStart_toEndOf="@id/imgFrame"
            app:layout_constraintTop_toBottomOf="@id/tvCartProductName"
            app:layout_constraintEnd_toStartOf="@id/btnRemove" />

        <!-- Quantity Controls -->
        <LinearLayout
            android:id="@+id/layoutQty"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_qty_control"
            app:layout_constraintStart_toEndOf="@id/imgFrame"
            app:layout_constraintTop_toBottomOf="@id/tvCartUnitPrice"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/btnDecrease"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:text="−"
                android:textColor="@color/colorPrimary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tvQuantity"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:text="1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@color/colorPrimary"
                android:gravity="center" />

            <TextView
                android:id="@+id/btnIncrease"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:text="+"
                android:textColor="@color/colorPrimary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>

        <!-- Line Total -->
        <TextView
            android:id="@+id/tvCartItemTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹0"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Remove Button -->
        <ImageButton
            android:id="@+id/btnRemove"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_delete"
            android:contentDescription="Remove item"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/error"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
