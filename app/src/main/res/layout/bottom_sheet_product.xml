<?xml version="1.0" encoding="utf-8"?>
<!--
  Bottom sheet that slides up when a product card is tapped.
  Design: Full-width product photo → floating card overlaps the image by 24dp.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Product image (fills top of sheet) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="230dp">

        <ImageView
            android:id="@+id/imgSheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:background="@color/white"
            android:padding="24dp"
            android:contentDescription="Product" />

        <!-- Out of stock red ribbon -->
        <TextView
            android:id="@+id/tvSheetOutOfStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:text="OUT OF STOCK"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="6dp"
            android:background="#CC990000"
            android:visibility="gone" />

    </FrameLayout>

    <!-- ── Floating card — overlaps image by 24dp ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-24dp"
        android:background="@drawable/bg_rounded_top"
        android:orientation="vertical">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:background="#CCCCCC" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <!-- Brand name -->
            <TextView
                android:id="@+id/tvSheetCompany"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.08" />

            <!-- Product name -->
            <TextView
                android:id="@+id/tvSheetName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:layout_marginTop="3dp" />

            <!-- Fake rating row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">
                <TextView
                    android:id="@+id/tvSheetRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ 4.3"
                    android:textSize="13sp"
                    android:textColor="#F8C51B"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · 1.2k+ sold  ·  ⚡ 10–20 min"
                    android:textSize="12sp"
                    android:textColor="@color/textSecondary" />
            </LinearLayout>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="12dp" android:layout_marginBottom="12dp" />

            <!-- Price row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvSheetPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="incl. taxes"
                    android:textSize="11sp"
                    android:textColor="@color/textSecondary" />
            </LinearLayout>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="12dp" android:layout_marginBottom="12dp" />

            <!-- About section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 About this product"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvSheetDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/textSecondary"
                android:lineSpacingMultiplier="1.55" />

            <!-- Delivery highlights -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⚡" android:textSize="20sp" android:gravity="center"
                        android:layout_gravity="center" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Express" android:textSize="11sp"
                        android:textColor="@color/textSecondary" android:gravity="center"
                        android:layout_gravity="center"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🛡️" android:textSize="20sp" android:gravity="center"
                        android:layout_gravity="center"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Fresh" android:textSize="11sp"
                        android:textColor="@color/textSecondary" android:gravity="center"
                        android:layout_gravity="center"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="↩" android:textSize="20sp" android:gravity="center"
                        android:layout_gravity="center"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="7-day Return" android:textSize="11sp"
                        android:textColor="@color/textSecondary" android:gravity="center"
                        android:layout_gravity="center"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="4dp" android:layout_marginBottom="14dp" />

            <!-- Quantity + Add to Cart -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <!-- Qty stepper box -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_add_btn">

                    <TextView
                        android:id="@+id/btnSheetDecrease"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:text="−"
                        android:textSize="20sp"
                        android:textColor="@color/colorPrimary"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="?attr/selectableItemBackground" />

                    <TextView
                        android:id="@+id/tvSheetQty"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:text="1"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@color/colorPrimary"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/btnSheetIncrease"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:text="+"
                        android:textSize="20sp"
                        android:textColor="@color/colorPrimary"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="?attr/selectableItemBackground" />

                </LinearLayout>

                <!-- Add button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSheetAdd"
                    style="@style/GreenButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Add to Cart"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:cornerRadius="10dp" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
