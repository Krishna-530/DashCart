<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash screen — Feature 4: Lottie animated splash.
    LottieAnimationView plays the local splash_animation.json.
    App name + tagline appear below the animation.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screenBackground">

    <!-- The Magic Box -->
    <TextView
        android:id="@+id/tvBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📦"
        android:textSize="100sp"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:translationY="-600dp" />

    <!-- Flying Items -->
    <TextView
        android:id="@+id/item1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🍕"
        android:textSize="40sp"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="@id/tvBox"
        app:layout_constraintBottom_toBottomOf="@id/tvBox"
        app:layout_constraintStart_toStartOf="@id/tvBox"
        app:layout_constraintEnd_toEndOf="@id/tvBox" />

    <TextView
        android:id="@+id/item2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🍎"
        android:textSize="40sp"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="@id/tvBox"
        app:layout_constraintBottom_toBottomOf="@id/tvBox"
        app:layout_constraintStart_toStartOf="@id/tvBox"
        app:layout_constraintEnd_toEndOf="@id/tvBox" />

    <TextView
        android:id="@+id/item3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🥛"
        android:textSize="40sp"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="@id/tvBox"
        app:layout_constraintBottom_toBottomOf="@id/tvBox"
        app:layout_constraintStart_toStartOf="@id/tvBox"
        app:layout_constraintEnd_toEndOf="@id/tvBox" />

    <TextView
        android:id="@+id/item4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🍔"
        android:textSize="40sp"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="@id/tvBox"
        app:layout_constraintBottom_toBottomOf="@id/tvBox"
        app:layout_constraintStart_toStartOf="@id/tvBox"
        app:layout_constraintEnd_toEndOf="@id/tvBox" />

    <TextView
        android:id="@+id/item5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🥦"
        android:textSize="40sp"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="@id/tvBox"
        app:layout_constraintBottom_toBottomOf="@id/tvBox"
        app:layout_constraintStart_toStartOf="@id/tvBox"
        app:layout_constraintEnd_toEndOf="@id/tvBox" />

    <TextView
        android:id="@+id/item6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🍣"
        android:textSize="40sp"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="@id/tvBox"
        app:layout_constraintBottom_toBottomOf="@id/tvBox"
        app:layout_constraintStart_toStartOf="@id/tvBox"
        app:layout_constraintEnd_toEndOf="@id/tvBox" />

    <!-- Brand Content (Revealed from Box) -->
    <LinearLayout
        android:id="@+id/llSplashContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:alpha="0"
        android:scaleX="0.5"
        android:scaleY="0.5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivSplashLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_grocery_logo"
            android:background="@drawable/bg_circle_green"
            android:padding="20dp"
            android:elevation="12dp" />

        <TextView
            android:id="@+id/tvSplashAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FreshCart"
            android:textColor="@color/textPrimary"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
