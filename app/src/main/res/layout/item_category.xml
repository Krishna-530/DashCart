<?xml version="1.0" encoding="utf-8"?>
<!--
    item_category.xml
    One pill chip in the horizontal category strip on the Home screen.
    Shows emoji + category name side by side.
    Selected = green fill, Unselected = white with grey border.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginEnd="8dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/tvCategory"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/bg_category_unselected"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tvCategoryEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:text="" />

        <TextView
            android:id="@+id/tvCategoryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            android:text="Category" />

    </LinearLayout>

</LinearLayout>
